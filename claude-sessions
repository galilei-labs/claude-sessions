#!/usr/bin/env python3
"""claude-sessions: list Claude Code sessions, live and past, with a fuzzy picker.

Live sessions come from the registry in ~/.claude/sessions/<pid>.json (kept only
while the process is alive); past ones from the transcripts in ~/.claude/projects.
Green dot = live, grey dot = past (revivable with `claude --resume`).

Usage:
  claude-sessions [QUERY...]        interactive picker (QUERY pre-fills the filter)
  claude-sessions -r | --resume     picker, then revive the chosen session in its cwd
  claude-sessions -R                same, with --dangerously-skip-permissions
  claude-sessions -r -- FLAGS...    extra FLAGS are passed through to claude
  claude-sessions -l | --list       plain table, no interaction
  claude-sessions --live            only sessions that are currently running
  claude-sessions --json            sessions as JSON
  claude-sessions --cwd  [QUERY]    print the chosen session's working directory
  claude-sessions --name [QUERY]    print the chosen session's name
  claude-sessions -n N              keep only the N most recent past sessions

On selection the session ID is printed to stdout (details go to stderr), so it
composes:   cd "$(claude-sessions --cwd)"     claude --resume "$(claude-sessions)"

Keys: type to filter · ↑/↓ or ^P/^N move · Enter select · Esc/^C quit
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

SESS_DIR = Path.home() / ".claude" / "sessions"
PROJ_DIR = Path.home() / ".claude" / "projects"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "claude-sessions" / "index.json"

# ── ANSI helpers ─────────────────────────────────────────────────────────────
ESC = "\x1b["
RESET, BOLD, DIM = ESC + "0m", ESC + "1m", ESC + "2m"
GREEN, YELLOW, RED, CYAN, MAGENTA = (ESC + c for c in ("32m", "33m", "31m", "36m", "35m"))
REV = ESC + "7m"


def strip_ansi(s):
    return re.sub(r"\x1b\[[0-9;]*m", "", s)


# ── Data ─────────────────────────────────────────────────────────────────────
def proc_comm(pid):
    try:
        out = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=2).stdout.strip()
        return out or None
    except Exception:
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def load_registry():
    """Live sessions from ~/.claude/sessions, keyed by sessionId."""
    live = {}
    if not SESS_DIR.is_dir():
        return live
    for f in SESS_DIR.glob("*.json"):
        try:
            d = json.loads(f.read_text())
        except Exception:
            continue
        pid = d.get("pid")
        if not isinstance(pid, int) or not alive(pid):
            continue
        # Guard against PID reuse: make sure the pid still belongs to claude.
        comm = proc_comm(pid)
        if comm is not None and "claude" not in os.path.basename(comm).lower() \
                and "node" not in os.path.basename(comm).lower():
            continue
        d["alive"] = True
        live[d.get("sessionId")] = d
    return live


def iso_ms(ts):
    """'2026-09-04T11:33:52.649Z' -> epoch ms, or None."""
    try:
        from datetime import datetime, timezone
        return int(datetime.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")
                   .replace(tzinfo=timezone.utc).timestamp() * 1000)
    except Exception:
        return None


def scan_transcript(path):
    """Cheap single pass over a transcript: title, cwd, first/last time, prompts."""
    info = {"sessionId": path.stem, "prompts": 0, "custom": None, "ai": None,
            "cwd": None, "first": None, "last": None, "firstPrompt": None}
    try:
        with open(path, "rb") as fh:
            for raw in fh:
                if raw.startswith(b'{"type":"custom-title"'):
                    try:
                        info["custom"] = json.loads(raw).get("customTitle") or info["custom"]
                    except Exception:
                        pass
                    continue
                if raw.startswith(b'{"type":"ai-title"'):
                    try:
                        info["ai"] = json.loads(raw).get("aiTitle") or info["ai"]
                    except Exception:
                        pass
                    continue
                if b'"timestamp"' not in raw:
                    continue
                m = re.search(rb'"timestamp":"([^"]+)"', raw)
                if m:
                    info["last"] = m.group(1).decode()
                    if info["first"] is None:
                        info["first"] = info["last"]
                if info["cwd"] is None:
                    m = re.search(rb'"cwd":"([^"]+)"', raw)
                    if m:
                        info["cwd"] = m.group(1).decode()
                if b'"type":"user"' in raw and b'"isMeta":true' not in raw \
                        and b'"role":"user","content":"' in raw:
                    info["prompts"] += 1
                    if info["firstPrompt"] is None:
                        try:
                            c = json.loads(raw)["message"]["content"]
                            if isinstance(c, str) and not c.startswith("<"):
                                info["firstPrompt"] = " ".join(c.split())[:60]
                        except Exception:
                            pass
    except OSError:
        return None
    return info


def load_transcripts():
    """Past (and live) sessions from ~/.claude/projects/*/<id>.jsonl."""
    out = {}
    if not PROJ_DIR.is_dir():
        return out
    try:
        cache = json.loads(CACHE.read_text())
    except Exception:
        cache = {}
    fresh, dirty = {}, False
    for path in PROJ_DIR.glob("*/*.jsonl"):
        try:
            st = path.stat()
        except OSError:
            continue
        key = str(path)
        stamp = [st.st_size, int(st.st_mtime)]
        hit = cache.get(key)
        if hit and hit.get("stamp") == stamp:
            info = hit["info"]
        else:
            info = scan_transcript(path)
            dirty = True
        fresh[key] = {"stamp": stamp, "info": info}
        if not info or (info["prompts"] == 0 and not info["custom"]):
            continue
        out[info["sessionId"]] = info
    if dirty or set(fresh) != set(cache):
        try:
            CACHE.parent.mkdir(parents=True, exist_ok=True)
            CACHE.write_text(json.dumps(fresh))
        except OSError:
            pass
    return out


def load_sessions(live_only=False, limit=None):
    live = load_registry()
    past = {} if live_only else load_transcripts()
    sessions = []
    for sid, d in live.items():
        t = past.get(sid)
        if t:
            d["aiTitle"] = t["ai"]
            d["prompts"] = t["prompts"]
        sessions.append(d)
    dead = []
    for sid, t in past.items():
        if sid in live:
            continue
        name = t["custom"] or t["ai"] or t["firstPrompt"]
        dead.append({
            "sessionId": sid, "alive": False, "pid": None, "status": "past",
            "cwd": t["cwd"], "name": name,
            "nameSource": "user" if t["custom"] else ("ai" if t["ai"] else "prompt"),
            "aiTitle": t["ai"], "prompts": t["prompts"],
            "startedAt": iso_ms(t["first"] or ""), "updatedAt": iso_ms(t["last"] or ""),
        })
    key = lambda d: d.get("updatedAt") or d.get("startedAt") or 0
    sessions.sort(key=key, reverse=True)
    dead.sort(key=key, reverse=True)
    if limit is not None:
        dead = dead[:limit]
    return sessions + dead


def display_name(d):
    """User-set name, else the session ID (with the derived name as a hint)."""
    if d.get("nameSource") == "user" and d.get("name"):
        return d["name"], True
    return (d.get("sessionId") or "?")[:8], False


def name_hint(d):
    """Secondary label for unnamed sessions: derived name or AI title."""
    return d.get("aiTitle") or d.get("name") or ""


def short_cwd(p):
    home = str(Path.home())
    if p and p.startswith(home):
        p = "~" + p[len(home):]
    return p or ""


def ago(ms):
    if not ms:
        return ""
    s = int(time.time() - ms / 1000)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def haystack(d):
    """(text for substring matching, tokens for per-token fuzzy matching).

    Session IDs and pids only take part in substring matching: hex soup makes
    subsequence matches meaningless.
    """
    fuzzy_src = " ".join(str(x) for x in (
        d.get("name"), d.get("aiTitle"), short_cwd(d.get("cwd")), d.get("status")) if x).lower()
    text = fuzzy_src + " " + " ".join(str(x) for x in (d.get("sessionId"), d.get("pid")) if x).lower()
    tokens = [t for t in re.split(r"[^a-z0-9]+", fuzzy_src) if t]
    return text, tokens


def subseq_spread(word, token):
    """Length of the shortest-first subsequence window of word in token, or None."""
    i, first, last = 0, -1, -1
    for j, ch in enumerate(token):
        if ch == word[i]:
            if first < 0:
                first = j
            last = j
            i += 1
            if i == len(word):
                return last - first
    return None


def fuzzy(word, text, tokens):
    """Score a query word against a haystack (lower is better), or None.

    A contiguous substring anywhere wins; otherwise the word must be a
    subsequence of a single token (so "crp" hits "corpo" but "corpo" does not
    hit "kattis-contract ... projects").
    """
    if word in text:
        return text.index(word)
    best = None
    for tok in tokens:
        sp = subseq_spread(word, tok)
        if sp is not None and (best is None or sp < best):
            best = sp
    return None if best is None else 1000 + best


def filter_sessions(sessions, query):
    words = query.lower().split()
    if not words:
        return list(sessions)
    scored = []
    for d in sessions:
        text, tokens = haystack(d)
        total = 0
        for w in words:
            s = fuzzy(w, text, tokens)
            if s is None:
                break
            total += s
        else:
            scored.append((total, d))
    scored.sort(key=lambda t: t[0])
    return [d for _, d in scored]


# ── Rendering ────────────────────────────────────────────────────────────────
def status_dot(d):
    st = d.get("status") or "?"
    if not d.get("alive"):
        return DIM + "○" + RESET, "past"
    color = {"idle": GREEN, "busy": YELLOW}.get(st, CYAN)
    return color + "●" + RESET, st


def row(d, width, selected=False, color=True):
    dot, st = status_dot(d)
    name, is_user = display_name(d)
    hint = name_hint(d)
    if not is_user and hint:
        room = 40 - len(name) - 4
        hint = hint if len(hint) <= room else hint[:room - 1] + "…"
        name_col = name + DIM + f"  ({hint})" + RESET
        plain_name = f"{name}  ({hint})"
    else:
        name_col = (BOLD + name + RESET) if is_user else name
        plain_name = name
    pad = max(0, 40 - len(plain_name))
    cwd = short_cwd(d.get("cwd"))
    pid = d.get("pid") or ""
    right = f"{ago(d.get('updatedAt') or d.get('startedAt')):>4}  {st:<4} {pid:>6}"
    # Trim cwd so the line fits the terminal.
    used = 2 + len(plain_name) + pad + 2 + len(right) + 2
    room = max(8, width - used)
    if len(cwd) > room:
        cwd = "…" + cwd[-(room - 1):]
    cwd_pad = max(0, room - len(cwd))
    line = f"{dot} {name_col}{' ' * pad}  {DIM}{cwd}{RESET}{' ' * cwd_pad}  {right}"
    if not color:
        line = strip_ansi(line)
    if selected:
        line = REV + strip_ansi(line) + RESET
    return line


def term_size():
    try:
        sz = os.get_terminal_size(sys.stderr.fileno())
        if sz.columns > 0 and sz.lines > 0:
            return sz.columns, sz.lines
        return 100, 24
    except OSError:
        return 100, 24


def print_table(sessions, color):
    width, _ = term_size()
    for d in sessions:
        print(row(d, width, color=color))


# ── Interactive picker ───────────────────────────────────────────────────────
def pick(sessions, query=""):
    import termios
    import tty

    err = sys.stderr
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sel = 0
    drawn = 0

    def draw():
        nonlocal drawn, sel
        width, height = term_size()
        matches = filter_sessions(sessions, query)
        sel = max(0, min(sel, len(matches) - 1))
        max_rows = max(1, height - 3)
        top = max(0, min(sel - max_rows + 1, len(matches) - max_rows)) if len(matches) > max_rows else 0
        visible = matches[top:top + max_rows]
        # Move to top of previously drawn block and clear it.
        out = ("\r" + ESC + f"{drawn}A" if drawn else "\r") + ESC + "J"
        out += f"{CYAN}❯{RESET} {query}{DIM}▏{RESET}  {DIM}{len(matches)}/{len(sessions)}{RESET}\r\n"
        for i, d in enumerate(visible):
            out += row(d, width, selected=(top + i == sel)) + "\r\n"
        if not matches:
            out += f"{DIM}  no match{RESET}\r\n"
        drawn = 1 + max(1, len(visible))
        err.write(out)
        err.flush()
        return matches

    try:
        tty.setraw(fd)
        err.write(ESC + "?25l")  # hide cursor
        matches = draw()
        while True:
            ch = os.read(fd, 1)
            if ch == b"\x1b":  # escape or arrow sequence
                seq = os.read(fd, 2) if _pending(fd) else b""
                if seq == b"[A":
                    sel -= 1
                elif seq == b"[B":
                    sel += 1
                elif seq == b"":
                    return None
            elif ch in (b"\x03", b"\x04"):  # ^C ^D
                return None
            elif ch in (b"\r", b"\n"):
                return matches[sel] if matches else None
            elif ch in (b"\x7f", b"\x08"):
                query = query[:-1]
            elif ch == b"\x15":  # ^U
                query = ""
            elif ch == b"\x17":  # ^W
                query = query.rstrip()
                query = query[:query.rfind(" ") + 1] if " " in query else ""
            elif ch == b"\x10":  # ^P
                sel -= 1
            elif ch == b"\x0e":  # ^N
                sel += 1
            elif ch == b"\t":
                sel += 1
            elif ch >= b" ":
                try:
                    query += ch.decode()
                except UnicodeDecodeError:
                    pass
            if sel < 0:
                sel = max(0, len(matches) - 1)
            matches = draw()
    finally:
        err.write(ESC + "?25h")
        err.write("\r" + ESC + f"{drawn}A" + ESC + "J" if drawn else "")
        err.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def _pending(fd):
    import select
    r, _, _ = select.select([fd], [], [], 0.02)
    return bool(r)


# ── Main ─────────────────────────────────────────────────────────────────────
def main(argv):
    args, words, limit, extra = [], [], None, []
    it = iter(argv)
    for a in it:
        if a == "--":
            extra = list(it)
            break
        if a == "-n":
            limit = int(next(it, "0"))
        elif a.startswith("-n") and a[2:].isdigit():
            limit = int(a[2:])
        elif a.startswith("-"):
            args.append(a)
        else:
            words.append(a)
    query = " ".join(words)
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0

    want_resume = bool({"-r", "--resume", "-R", "--resume-skip-permissions"} & set(args))
    if "-R" in args or "--resume-skip-permissions" in args:
        extra = ["--dangerously-skip-permissions"] + extra

    sessions = load_sessions(live_only="--live" in args, limit=limit)
    color = sys.stderr.isatty() and "--no-color" not in args

    if "--json" in args:
        print(json.dumps(filter_sessions(sessions, query), indent=2))
        return 0
    if not sessions:
        print("no Claude Code sessions found", file=sys.stderr)
        return 1

    interactive = sys.stdin.isatty() and sys.stderr.isatty() and not ("-l" in args or "--list" in args)
    if not interactive:
        matches = filter_sessions(sessions, query)
        if "--cwd" in args or "--name" in args or want_resume:
            if not matches:
                return 1
            d = matches[0]
            if want_resume:
                return resume(d, extra)
            print(d.get("cwd") if "--cwd" in args else d.get("name"))
            return 0
        print_table(matches, color and sys.stdout.isatty())
        return 0

    chosen = pick(sessions, query)
    if chosen is None:
        return 130
    if want_resume:
        return resume(chosen, extra)
    if "--cwd" in args:
        print(chosen.get("cwd"))
    elif "--name" in args:
        print(chosen.get("name"))
    else:
        dot, st = status_dot(chosen)
        tail = f"pid {chosen.get('pid')}  {st}" if chosen.get("alive") else \
            f"{st}  revive: claude --resume {chosen.get('sessionId')}"
        print(f"{dot} {BOLD}{chosen.get('name')}{RESET}  {DIM}{short_cwd(chosen.get('cwd'))}  "
              f"{tail}{RESET}", file=sys.stderr)
        print(chosen.get("sessionId"))
    return 0


def resume(d, extra=()):
    """Replace this process with `claude --resume <id> [extra...]` in the session's cwd."""
    cwd = d.get("cwd")
    if cwd and os.path.isdir(cwd):
        os.chdir(cwd)
    else:
        print(f"warning: cwd {cwd!r} missing, resuming from here", file=sys.stderr)
    cmd = ["claude", "--resume", d.get("sessionId"), *extra]
    print(f"{DIM}{' '.join(cmd)}  ({short_cwd(cwd)}){RESET}", file=sys.stderr)
    try:
        os.execvp("claude", cmd)
    except OSError as e:
        print(f"failed to exec claude: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
